{
  "name": "easymarker",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "seed": "dotenv -e .env.local -- tsx scripts/seed.ts"
  },
  "dependencies": {
    "@easymarker/db": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "dotenv-cli": "^7.4.4",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "engines": { "node": ">=20", "pnpm": ">=8" },
  "packageManager": "pnpm@9.12.3"
}
